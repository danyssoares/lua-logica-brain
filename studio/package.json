{
  "name": "lua-logica-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline de produção de Reels e carrosséis da Lua Lógica: pauta (Supabase) -> imagem (Replicate) -> composição (Remotion) -> aprovação.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:reel": "remotion render src/index.ts Reel",
    "render:slide": "remotion render src/index.ts CarrosselSlide",
    "pauta:dia": "tsx src/pipeline/runDay.ts",
    "pauta:manual": "tsx src/pipeline/runDay.ts --file=manual/exemplo-dia.json"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.286",
    "@remotion/cli": "4.0.286",
    "@remotion/fonts": "4.0.286",
    "@remotion/renderer": "4.0.286",
    "@remotion/transitions": "4.0.286",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.286",
    "replicate": "^0.34.1"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4"
  }
}
