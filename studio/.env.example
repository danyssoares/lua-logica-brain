# Copie este arquivo para .env e preencha. NUNCA commitar o .env (já está no .gitignore).

# Supabase — tabela com a pauta mensal
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PAUTA_TABLE=pauta_mensal

# Replicate — geração de imagem
REPLICATE_API_TOKEN=
# Confirmar modelo definitivo junto do prompt mestre (ver prompts/master-image-prompt.md)
REPLICATE_MODEL=black-forest-labs/flux-1.1-pro
